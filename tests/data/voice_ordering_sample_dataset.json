        "state": "waiting_for_order_type",
        "caller_device_type": "phone",
        "order_type": null
      },
      "turns": [
        {"utterance": "pickup", "scripted_intent": "unknown", "scripted_slots": []},
        {"utterance": "chicken taco", "scripted_intent": "add_item", "scripted_slots": [{"name": "ITEM", "value": "Chicken Taco"}]},
        {"utterance": "huh", "scripted_intent": "unknown", "scripted_slots": []},
        {"utterance": "whatever", "scripted_intent": "unknown", "scripted_slots": []},
        {"utterance": "still not sure", "scripted_intent": "unknown", "scripted_slots": []}
      ],
      "expected_final_state": "waiting_for_side",
