  "conversation_scenarios": [
    {
      "id": "happy_path_checkout",
      "category": "flow",
      "counts_toward_order_turns": true,
      "setup": {
        "state": "waiting_for_order_type",
        "caller_device_type": "phone",
        "order_type": null
      },
      "turns": [
        {"utterance": "pickup", "scripted_intent": "unknown", "scripted_slots": []},
        {"utterance": "burger with lettuce tomato no onions extra cheese", "scripted_intent": "add_item", "scripted_slots": [{"name": "ITEM", "value": "Burger"}]},
        {"utterance": "1", "scripted_intent": "unknown", "scripted_slots": [{"name": "QUANTITY", "value": "1"}]},
        {"utterance": "chocolate cake", "scripted_intent": "add_item", "scripted_slots": [{"name": "ITEM", "value": "Chocolate Cake"}]},
        {"utterance": "1", "scripted_intent": "unknown", "scripted_slots": [{"name": "QUANTITY", "value": "1"}]},
        {"utterance": "checkout", "scripted_intent": "checkout", "scripted_slots": []},
        {"utterance": "go ahead", "scripted_intent": "confirm", "scripted_slots": []}
      ],
      "expected_final_state": "waiting_for_payment",
      "expected_response_keys": ["confirm_order_summary", "payment_link_sent"]
    },
    {
      "id": "partial_input_missing_only_quantity",
      "category": "flow",
      "counts_toward_order_turns": false,
      "setup": {
        "state": "waiting_for_order_type",
        "caller_device_type": "phone",
        "order_type": null
      },
      "turns": [
        {"utterance": "pickup", "scripted_intent": "unknown", "scripted_slots": []},
        {"utterance": "burger with lettuce", "scripted_intent": "add_item", "scripted_slots": [{"name": "ITEM", "value": "Burger"}]}
      ],
      "expected_final_state": "waiting_for_quantity",
      "expected_response_keys": ["ask_for_quantity"]
    },
    {
      "id": "delivery_checkout_after_call",
      "category": "payment",
      "counts_toward_order_turns": false,
      "setup": {
        "state": "confirming_order",
        "caller_device_type": "chat",
        "order_type": "delivery",
        "seed_items": ["Burger"],
        "delivery_area": "Downtown",
        "delivery_postal_code": "12345"
      },
      "turns": [
        {"utterance": "go ahead", "scripted_intent": "confirm", "scripted_slots": []},
        {"utterance": "I'll complete it after the call", "scripted_intent": "unknown", "scripted_slots": []}
      ],
      "expected_final_state": "waiting_for_checkout_completion",
      "expected_response_keys": ["checkout_link_sent", "checkout_after_call_selected"]
    },
    {
      "id": "invalid_side_recovery",
