# Speech
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Telephony
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Public endpoint used by Twilio Media Streams
PUBLIC_WSS_BASE_URL=https://your-public-host.example

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Intent model
COMPASS_INTENT_DEVICE=auto
COMPASS_INTENT_USE_AMP=true
COMPASS_INTENT_CONF_THRESHOLD=0.55

# Runtime logging
COMPASS_REALTIME_LATENCY_LOG_PATH=./runtime-logs/realtime_turn_latency.jsonl
COMPASS_REALTIME_LATENCY_CSV_PATH=./runtime-logs/realtime_turn_latency.csv
COMPASS_NLU_CSV_LOG_DIR=./runtime-logs/nlu

# Debugging
COMPASS_VOICE_DEBUG_ENABLED=0
COMPASS_VOICE_TRANSCRIPT_DEBUG_ENABLED=0
COMPASS_VOICE_MEDIA_PROGRESS_DEBUG_ENABLED=0