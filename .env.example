# =============================================================================
# Compass Voice — environment template
# =============================================================================
# Copy this file to `.env` on the deploy host (e.g. /home/ubuntu/apps/compass-voice/.env)
# and fill in real values. Docker Compose auto-loads `.env` from the project
# directory at `docker compose up` time.
#
# DO NOT commit `.env` to git. It is excluded by .gitignore.
# Permissions on the host: chmod 600 .env && chown ubuntu:ubuntu .env
# =============================================================================

# ---- Required: Deepgram (STT + TTS) -----------------------------------------
DEEPGRAM_API_KEY=

# ---- Required: Twilio (voice + SMS) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# ---- Required: Datacap (payment links) --------------------------------------
DATACAP_BASIC_USERNAME=
DATACAP_BASIC_PASSWORD=

# ---- Optional overrides (defaults are usually fine) -------------------------
# COMPASS_PAYMENT_POLL_INTERVAL=6
# COMPASS_PAYMENT_POLL_MAX_DURATION=900
# COMPASS_REVERSE_GEOCODE_USER_AGENT=CompassCheckout/1.0 (support@cygnuspayments.com)
