# =========================
# ✅ NEWLY ADDED (IMPORTANT)
# =========================

# Runtime logs (per-branch, never tracked)
app/logs/
logs/
*.jsonl
*.csv

# Allow test fixtures and data explicitly
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.jsonl
!app/data/**/*.csv

# Local model artifacts / caches
*.pt
*.pkl
*.bin
.cache/

# OS junk
.DS_Store
Thumbs.db

app/data/checkout_sessions/
app/data/payment_link_sessions/
app/data/payment_sessions/
app/data/evals/
*.safetensors
*.bin
*.pt

# ============================================================
# Canonical production model artifacts — must NOT be ignored.
# Models live at app/artifacts/models/ (inside the app package).
# The global *.safetensors / *.bin / *.pt rules above would
# swallow these, so we explicitly negate them here.
# Do NOT move these negation lines above the binary ignore rules.
# ============================================================
!app/artifacts/
!app/artifacts/models/
!app/artifacts/models/**